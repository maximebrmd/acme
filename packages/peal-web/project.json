{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "peal-web",
  "projectType": "application",
  "targets": {
    "typegen": {
      "command": "next typegen",
      "options": {
        "cwd": "{projectRoot}"
      }
    },
    "typecheck": {
      "command": "tsc --noEmit",
      "options": {
        "cwd": "{projectRoot}"
      },
      "dependsOn": ["typegen"]
    },
    "build": {
      "command": "next build",
      "options": {
        "cwd": "{projectRoot}"
      },
      "outputs": ["{projectRoot}/.next"]
    },
    "dev": {
      "command": "next dev --port 3001",
      "options": {
        "cwd": "{projectRoot}"
      },
      "continuous": true
    },
    "test": {
      "command": "vitest run",
      "options": {
        "cwd": "{projectRoot}"
      }
    }
  }
}
