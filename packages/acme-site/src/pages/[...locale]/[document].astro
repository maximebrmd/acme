---
import type { GetStaticPaths } from "astro";
import { getEntry, render } from "astro:content";

import { pageLocale } from "../../i18n/locales.ts";
import { messages } from "../../i18n/messages.ts";
import Base from "../../layouts/base.astro";
import { legalDocument, legalPaths } from "../../legal.ts";

export const getStaticPaths = (() => legalPaths()) satisfies GetStaticPaths;

const { document: parameter } = Astro.params;

const document = legalDocument(parameter);

const locale = pageLocale(Astro.currentLocale);

const entry =
  document === undefined
    ? undefined
    : await getEntry("legal", `${locale}/${document}`);

if (document === undefined || entry === undefined) {
  throw new Error(
    `No legal document at src/content/legal/${locale}/${parameter ?? ""}.md: each one needs a version in every locale.`
  );
}

const { Content } = await render(entry);

const t = messages(locale);
---

<Base
  description={entry.data.description}
  noindex={entry.data.draft}
  path={document}
  title={`${entry.data.title} · ${t.nav.brand}`}
>
  <article
    class="prose mx-auto max-w-3xl px-6 py-16 prose-neutral dark:prose-invert prose-table:text-sm"
  >
    {
      entry.data.draft && (
        <aside
          role="note"
          class="not-prose mb-10 rounded-2xl border border-amber-300 bg-amber-50 p-5 text-amber-950 dark:border-amber-700 dark:bg-amber-950 dark:text-amber-100"
        >
          <p class="font-semibold">{t.draft.title}</p>
          <p class="mt-1 text-sm">{t.draft.body}</p>
        </aside>
      )
    }
    <h1>{entry.data.title}</h1>
    <Content />
  </article>
</Base>
