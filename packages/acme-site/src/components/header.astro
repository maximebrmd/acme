---
import { getRelativeLocaleUrl } from "astro:i18n";

import { docsLink } from "../config.ts";
import type { Locale } from "../i18n/locales.ts";
import { messages } from "../i18n/messages.ts";
import LanguageLinks from "./language-links.astro";

interface Props {
  readonly locale: Locale;
  readonly path: string;
}

const { locale, path } = Astro.props;

const t = messages(locale);

const docs = docsLink(locale);
---

<header class="border-b border-neutral-200 dark:border-neutral-800">
  <div
    class="mx-auto flex max-w-5xl items-center justify-between gap-6 px-6 py-4"
  >
    <a
      href={getRelativeLocaleUrl(locale)}
      aria-label={t.nav.home}
      class="text-lg font-semibold tracking-tight"
    >
      {t.nav.brand}
    </a>
    <div class="flex items-center gap-6">
      {
        docs !== undefined && (
          <nav aria-label={t.nav.main}>
            <a
              href={docs}
              class="text-sm font-medium text-neutral-700 hover:text-neutral-900 dark:text-neutral-300 dark:hover:text-neutral-100"
            >
              {t.nav.docs}
            </a>
          </nav>
        )
      }
      <LanguageLinks label={t.footer.language} locale={locale} path={path} />
    </div>
  </div>
</header>
