# Overrides for the development stack in compose.yaml. Copy this file to .env
# beside it and change what you need; compose.yaml holds the same defaults.
# These are synthetic local values: never put a real credential here.

# Postgres
ACME_POSTGRES_PORT=15432
ACME_POSTGRES_USER=acme
ACME_POSTGRES_PASSWORD=acme
ACME_POSTGRES_DB=acme

# S3 API (SeaweedFS). The key pair is the admin identity; the bucket is
# created at startup.
ACME_S3_PORT=18333
ACME_S3_ACCESS_KEY_ID=acme
ACME_S3_SECRET_ACCESS_KEY=acme-development-secret
ACME_S3_BUCKET=acme-media
ACME_SEAWEEDFS_FILER_PORT=18888

# Mail (Mailpit): SMTP accepts any user and password.
ACME_SMTP_PORT=11025
ACME_MAILPIT_PORT=18025

# Telemetry: the OpenTelemetry Collector's OTLP receivers, then the backends
# and Grafana (anonymous admin).
ACME_OTLP_GRPC_PORT=14317
ACME_OTLP_HTTP_PORT=14318
ACME_LOKI_PORT=13100
ACME_TEMPO_PORT=13200
ACME_PROMETHEUS_PORT=19090
ACME_GRAFANA_PORT=13000
