#!/bin/sh
# Managed by Ansible (peal-infra). Docker Compose on the release that runs,
# with its settings: `sudo peal-compose ps`, `logs --tail 50 server`,
# `exec postgres psql --username peal`. Later env files win.
set -eu
exec docker compose \
  --project-name {{ peal_compose_project }} \
  --project-directory {{ peal_root }}/current \
  --file {{ peal_root }}/current/compose.production.yaml \
{% for profile in peal_compose_profiles %}
  --profile {{ profile }} \
{% endfor %}
  --env-file {{ peal_root }}/host.env \
  --env-file {{ peal_root }}/credentials.env \
  --env-file {{ peal_root }}/secrets.env \
  --env-file {{ peal_root }}/release.env \
  "$@"
