# Managed by Ansible (peal-infra). A full backup every Sunday; one missed
# while the server was down runs when it is back.
[Unit]
Description=Full backup of the Peal database, weekly

[Timer]
OnCalendar=Sun *-*-* 02:15:00 UTC
RandomizedDelaySec=10m
Persistent=true
Unit=peal-backup@full.service

[Install]
WantedBy=timers.target
