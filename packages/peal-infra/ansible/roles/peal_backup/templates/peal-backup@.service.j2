# Managed by Ansible (peal-infra). One backup of the Peal database: %i is
# full, diff or incr.
[Unit]
Description=Back the Peal database up (%i)
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
# The full and the differential backups are two units: one waits for the
# other rather than meet pgBackRest's lock and report a failure.
ExecStart=/usr/bin/flock /run/peal-backup.lock /usr/local/sbin/peal-backup %i
Nice=10
IOSchedulingClass=idle
