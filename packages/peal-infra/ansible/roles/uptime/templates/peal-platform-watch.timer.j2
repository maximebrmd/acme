# Managed by Ansible (peal-infra). The platform watch every 6 hours, a
# random delay after, so its requests do not land on the hour; a run missed
# while the server was down runs at boot (Persistent=true).
[Unit]
Description=Post the platforms' changelog changes to Slack every 6 hours

[Timer]
OnCalendar={{ uptime_platform_watch_schedule }}
RandomizedDelaySec={{ uptime_platform_watch_delay }}
Persistent=true

[Install]
WantedBy=timers.target
