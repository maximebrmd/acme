# Managed by Ansible (peal-infra). Reads the platforms' changelog pages and
# feeds once, and posts what changed to Slack (README.md, "The platform
# watch"). It runs as gatus, which cannot reach {{ uptime_root }}: systemd,
# as root, reads the webhook's file and mounts the watch's folder where the
# script finds it. The webhook stays in the environment, off the command
# line.
[Unit]
Description=Post the platforms' changelog changes to Slack
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=gatus
Group=gatus
EnvironmentFile={{ uptime_root }}/platform-watch.env
BindPaths={{ uptime_platform_watch_root }}:/var/lib/peal-platform-watch
ExecStart={{ uptime_platform_watch_python }} -I {{ uptime_platform_watch_bin }} --sources /var/lib/peal-platform-watch/sources.json --state /var/lib/peal-platform-watch/state
TimeoutStartSec=30min
Nice=10
UMask=0077
NoNewPrivileges=true
CapabilityBoundingSet=
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
SystemCallArchitectures=native
