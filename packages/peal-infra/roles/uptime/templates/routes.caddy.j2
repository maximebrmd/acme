# Managed by Ansible (peal-infra). What the uptime server answers on its
# public name: the heartbeats Grafana posts, the status page when
# uptime_public_status is on, and 404 for anything else. Gatus's dashboard
# otherwise stays on 127.0.0.1, for SSH port forwarding.
header -Server

# A Grafana's heartbeat, which Gatus takes only with that environment's
# token (POST /api/v1/endpoints/<group>_<name>/external).
@heartbeat {
	method POST
	path_regexp ^/api/v1/endpoints/[a-z0-9-]+_[a-z0-9-]+/external$
}
handle @heartbeat {
	request_body {
		max_size 64KB
	}
	reverse_proxy gatus:8080
}
{% if uptime_public_status %}

# The status page: Gatus's dashboard and its read-only API.
@status method GET HEAD
handle @status {
	reverse_proxy gatus:8080
}
{% endif %}

handle {
	respond 404
}
