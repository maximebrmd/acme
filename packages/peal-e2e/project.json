{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "acme-e2e",
  "projectType": "application",
  "implicitDependencies": ["acme-server", "acme-web"],
  "targets": {
    "typecheck": {
      "command": "tsc --noEmit",
      "options": { "cwd": "{projectRoot}" }
    },
    "e2e": {
      "command": "e2e run",
      "options": {
        "cwd": "{projectRoot}",
        "env": { "E2E_TELEMETRY_DISABLED": "1" }
      },
      "dependsOn": ["acme-web:build"]
    }
  }
}
