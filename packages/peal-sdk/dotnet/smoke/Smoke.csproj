<Project Sdk="Microsoft.NET.Sdk">

  <!-- The smoke test, which scripts/test.ts runs against a stand-in API. Not
       packed: NuGet gets src/Peal alone. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../src/Peal/Peal.csproj" />
  </ItemGroup>

</Project>
