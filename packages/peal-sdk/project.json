{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "peal-sdk",
  "projectType": "library",
  "tags": ["sdk-spec"],
  "targets": {
    "typecheck": {
      "command": "tsc --noEmit",
      "options": {
        "cwd": "{projectRoot}"
      }
    },
    "spec": {
      "command": "bun scripts/spec.ts",
      "options": {
        "cwd": "{projectRoot}"
      },
      "dependsOn": [
        {
          "projects": ["peal-contract"],
          "target": "openapi"
        }
      ],
      "cache": false
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "commands": ["bun test scripts", "bun scripts/compat.ts"],
        "cwd": "{projectRoot}",
        "parallel": false
      },
      "dependsOn": ["spec"],
      "cache": false
    },
    "check": {
      "command": "bun scripts/check.ts",
      "options": {
        "cwd": "{projectRoot}"
      },
      "dependsOn": [
        {
          "projects": ["tag:sdk"],
          "target": "sdk:generate"
        }
      ],
      "cache": false
    }
  }
}
