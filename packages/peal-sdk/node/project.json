{
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "name": "peal-sdk-node",
  "projectType": "library",
  "tags": ["sdk"],
  "targets": {
    "sdk:generate": {
      "command": "bun scripts/generate.ts node",
      "options": { "cwd": "packages/peal-sdk" }
    },
    "sdk:build": {
      "command": "bun scripts/build.ts node",
      "options": { "cwd": "packages/peal-sdk" },
      "outputs": ["{projectRoot}/dist"]
    }
  }
}
