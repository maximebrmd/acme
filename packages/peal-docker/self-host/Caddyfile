# Caddy in front of a self-hosted Peal (compose.self-host.yaml). It gets and
# renews a certificate for PEAL_DOMAIN from Let's Encrypt, which needs the
# domain's DNS pointing at this host and ports 80 and 443 open to the world.
#
# The server answers /api/* (the HTTP API, sign-in and the MCP endpoint) and
# the OAuth discovery documents under /.well-known/oauth-*; the web app
# answers everything else. Caddy replaces any X-Forwarded-For the client
# sent with the address it sees, so set AUTH_IP_HEADERS=x-forwarded-for.

{$PEAL_DOMAIN} {
	encode zstd gzip

	# The web app sets the security headers, HSTS included.
	header -Server

	@server path /api/* /.well-known/oauth-*
	handle @server {
		reverse_proxy server:3000 {
			# Caddy sets no time limit on a request by default; this one
			# says it outright. The writing assistant answers within 90
			# seconds, and the web app's own forwarding waits 120, so Caddy
			# waits longer than both before it gives up on an answer.
			transport http {
				dial_timeout 10s
				response_header_timeout 150s
			}
		}
	}

	handle {
		reverse_proxy web:3001 {
			transport http {
				dial_timeout 10s
				response_header_timeout 150s
			}
		}
	}
}

# The marketing site and the docs, if you serve them too: start the stack with
# `--profile static`, set the domains in compose.self-host.yaml's caddy
# service, and uncomment.
#
# {$PEAL_SITE_DOMAIN} {
# 	encode zstd gzip
# 	reverse_proxy static:8080
# }
#
# {$PEAL_DOCS_DOMAIN} {
# 	encode zstd gzip
# 	reverse_proxy static:8081
# }
#
# Or, with the docs' assistant (DOCS_ASSISTANT_MODEL set, and the stack
# started with `--profile docs` too), the docs server instead of the block
# above. Caddy passes the host name through and replaces X-Forwarded-For
# with the reader's address, which the assistant's rate limit counts by
# (AUTH_IP_HEADERS=x-forwarded-for), and sends the answer as it streams.
#
# {$PEAL_DOCS_DOMAIN} {
# 	encode zstd gzip
# 	reverse_proxy docs:4323 {
# 		flush_interval -1
# 	}
# }

# Short links on a domain of their own (PEAL_SHORT_LINK_BASE set to
# https://{$PEAL_SHORT_LINK_DOMAIN}/): Caddy sends each /<code> to the
# server's /api/l/<code>, and nothing else. Set the domain in
# compose.self-host.yaml's caddy service, and uncomment. With
# PEAL_SHORT_LINK_BASE set to https://{$PEAL_DOMAIN}/api/l/ instead, the
# block above serves them and nothing here is needed.
#
# {$PEAL_SHORT_LINK_DOMAIN} {
# 	header -Server
#
# 	@code path_regexp code ^/([0-9A-Za-z]{7})$
# 	handle @code {
# 		rewrite * /api/l/{re.code.1}
# 		reverse_proxy server:3000
# 	}
#
# 	handle {
# 		respond 404
# 	}
# }
