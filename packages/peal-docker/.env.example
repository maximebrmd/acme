# Overrides for the development stack in compose.yaml. Copy this file to .env
# beside it and change what you need; compose.yaml holds the same defaults.
# These are synthetic local values: never put a real credential here.

# Postgres
PEAL_POSTGRES_PORT=15432
PEAL_POSTGRES_USER=peal
PEAL_POSTGRES_PASSWORD=peal
PEAL_POSTGRES_DB=peal

# S3 API (SeaweedFS). The key pair is the admin identity; the bucket is
# created at startup.
PEAL_S3_PORT=18333
PEAL_S3_ACCESS_KEY_ID=peal
PEAL_S3_SECRET_ACCESS_KEY=peal-development-secret
PEAL_S3_BUCKET=peal-media
PEAL_SEAWEEDFS_FILER_PORT=18888

# Mail (Mailpit): SMTP accepts any user and password.
PEAL_SMTP_PORT=11025
PEAL_MAILPIT_PORT=18025

# Stripe's API mocked (stripe-mock), for the billing tests.
PEAL_STRIPE_MOCK_PORT=12111

# Telemetry: the OpenTelemetry Collector's OTLP receivers, then the backends
# and Grafana (anonymous admin).
PEAL_OTLP_GRPC_PORT=14317
PEAL_OTLP_HTTP_PORT=14318
PEAL_LOKI_PORT=13100
PEAL_TEMPO_PORT=13200
PEAL_PROMETHEUS_PORT=19090
PEAL_GRAFANA_PORT=13000
