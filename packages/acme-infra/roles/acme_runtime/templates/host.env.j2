# Managed by Ansible (acme-infra). Plain settings for compose.production.yaml;
# secrets are in secrets.env (generated here) and credentials.env (issued by
# outside services), beside this file. The settings are
# acme_runtime_host_settings, which the role checks before writing them.
{% for name, value in acme_runtime_host_settings.items() %}
{{ name }}='{{ (value | string | lower) if value is boolean else value }}'
{% endfor %}
