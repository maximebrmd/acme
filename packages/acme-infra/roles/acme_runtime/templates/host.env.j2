# Managed by Ansible (acme-infra). Plain settings for compose.production.yaml;
# secrets are in secrets.env (generated here) and credentials.env (issued by
# outside services), beside this file.
{% macro setting(name, value) %}{{ name }}='{{ value }}'{% endmacro %}
{{ setting('PUBLIC_URL', 'https://' ~ acme_hostnames.app) }}
{{ setting('AUTH_IP_HEADERS', 'cf-connecting-ip') }}
{{ setting('MAIL_FROM', acme_mail_from) }}
{{ setting('ACME_S3_ENDPOINT', acme_media_endpoint) }}
{{ setting('ACME_S3_BUCKET', acme_media_bucket) }}
{{ setting('ACME_POSTGRES_ARCHIVE_MODE', 'on') }}
{{ setting('PGBACKREST_REPO1_S3_ENDPOINT', acme_backup_endpoint) }}
{{ setting('PGBACKREST_REPO1_S3_BUCKET', acme_backup_bucket) }}
{{ setting('PGBACKREST_REPO1_PATH', acme_backup_path) }}
{{ setting('ACME_GRAFANA_URL', 'https://' ~ acme_hostnames.grafana) }}
{{ setting('ACME_GRAFANA_ACCESS_TEAM', cloudflare_access_team) }}
{{ setting('ACME_GRAFANA_ACCESS_AUD', cloudflare_access_aud.grafana) }}
{{ setting('ACME_GRAFANA_CONTACT_POINTS', './config/production/grafana/alerting/telegram.yaml') }}
{{ setting('ACME_SERVER_PORT', acme_ports.server) }}
{{ setting('ACME_WEB_PORT', acme_ports.web) }}
{{ setting('ACME_SITE_PORT', acme_ports.site) }}
{{ setting('ACME_DOCS_PORT', acme_ports.docs) }}
{{ setting('ACME_GRAFANA_PORT', acme_ports.grafana) }}
{{ setting('ACME_OTLP_HTTP_PORT', acme_ports.otlp_http) }}
{% for name, value in acme_settings | dictsort %}
{{ setting(name, value) }}
{% endfor %}
