        "name": "channels_status",
        "value": "\"status\" IN ('active', 'refreshNeeded', 'disabled')",
        "entityType": "checks"
      }
    },
    {
      "op": "create",
      "row": {
        "schema": "channels",
        "table": "channels",
        "name": "channels_refresh_needed",
        "value": "(\"status\" <> 'active' OR NOT \"refresh_needed\") AND (\"status\" <> 'refreshNeeded' OR \"refresh_needed\")",
        "entityType": "checks"
      }
    },
    {
      "op": "create",
      "row": {
        "schema": "channels",
        "table": "channels",
        "name": "channels_token_lifetime",
        "value": "CASE \"token_kind\" WHEN 'nonExpiring' THEN \"token_expires_at\" IS NULL AND \"token_issued_at\" IS NULL WHEN 'refreshable' THEN \"token_expires_at\" IS NOT NULL AND \"token_issued_at\" IS NULL WHEN 'nonRefreshable' THEN \"token_expires_at\" IS NOT NULL AND \"token_issued_at\" IS NOT NULL ELSE FALSE END",
        "entityType": "checks"
      }
    },
    {
      "op": "create",
      "row": {
        "schema": "channels",
        "table": "channels",
        "name": "channels_token_key",
        "value": "split_part(\"access_token\", '.', 1) = \"token_key_id\" AND (\"refresh_token\" IS NULL OR split_part(\"refresh_token\", '.', 1) = \"token_key_id\")",
        "entityType": "checks"
      }
