{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "acme-docs",
  "projectType": "application",
  "implicitDependencies": ["acme-contract"],
  "targets": {
    "typecheck": {
      "command": "tsc --noEmit && blume check --strict --isolated",
      "options": { "cwd": "{projectRoot}" },
      "dependsOn": ["acme-contract:openapi"]
    },
    "validate": {
      "command": "blume validate --strict",
      "options": { "cwd": "{projectRoot}" },
      "dependsOn": ["acme-contract:openapi"],
      "cache": false
    },
    "test": {
      "executor": "nx:noop",
      "dependsOn": ["validate"]
    },
    "build": {
      "command": "blume build",
      "options": { "cwd": "{projectRoot}" },
      "dependsOn": ["...", "acme-contract:openapi"],
      "inputs": [
        "...",
        { "env": "DOCS_SITE_URL" },
        { "env": "DOCS_PLAUSIBLE_DOMAIN" },
        { "env": "DOCS_PLAUSIBLE_HOST" }
      ],
      "outputs": ["{projectRoot}/dist"]
    },
    "dev": {
      "command": "blume dev --port 4322",
      "options": { "cwd": "{projectRoot}" },
      "dependsOn": ["acme-contract:openapi"],
      "continuous": true
    }
  }
}
