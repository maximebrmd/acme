{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "peal-contract",
  "projectType": "library",
  "targets": {
    "typecheck": {
      "command": "tsc --noEmit",
      "options": { "cwd": "{projectRoot}" }
    },
    "openapi": {
      "command": "bun scripts/openapi.ts",
      "options": { "cwd": "{projectRoot}" },
      "cache": true,
      "inputs": ["default"],
      "outputs": ["{projectRoot}/openapi.json"]
    }
  }
}
