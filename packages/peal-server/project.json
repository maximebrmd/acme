{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "peal-server",
  "projectType": "application",
  "targets": {
    "typecheck": {
      "command": "tsc --noEmit",
      "options": { "cwd": "{projectRoot}" }
    },
    "test": {
      "command": "vitest run",
      "options": { "cwd": "{projectRoot}" },
      "dependsOn": ["auth-schema-check"]
    },
    "dev": {
      "command": "bun --watch src/main.ts",
      "options": { "cwd": "{projectRoot}" },
      "continuous": true
    },
    "auth-schema": {
      "command": "bun scripts/auth-schema.ts",
      "options": { "cwd": "{projectRoot}" },
      "cache": false
    },
    "auth-schema-check": {
      "command": "bun scripts/auth-schema.ts --check",
      "options": { "cwd": "{projectRoot}" },
      "cache": true,
      "inputs": ["default", "^default", "{workspaceRoot}/oxfmt.config.ts"]
    },
    "bluesky-key": {
      "command": "bun scripts/bluesky-key.ts",
      "options": { "cwd": "{projectRoot}" },
      "cache": false
    },
    "db:generate": {
      "command": "drizzle-kit generate",
      "options": { "cwd": "{projectRoot}" },
      "cache": false
    },
    "media-cors": {
      "command": "bun scripts/media-cors.ts",
      "options": { "cwd": "{projectRoot}" },
      "cache": false
    },
    "erasures:replay": {
      "command": "bun src/replay-erasures.ts",
      "options": { "cwd": "{projectRoot}" },
      "cache": false
    },
    "db:migrate": {
      "command": "bun src/migrate.ts",
      "options": { "cwd": "{projectRoot}" },
      "cache": false
    }
  }
}
