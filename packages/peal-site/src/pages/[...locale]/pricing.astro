---
import type { GetStaticPaths } from "astro";
import { getRelativeLocaleUrl } from "astro:i18n";

import { localePaths, pageLocale } from "../../i18n/locales.ts";
import { messages } from "../../i18n/messages.ts";
import Base from "../../layouts/base.astro";
import { pricingPage } from "../../pricing.ts";

export const getStaticPaths = (() => localePaths()) satisfies GetStaticPaths;

const locale = pageLocale(Astro.currentLocale);

const t = messages(locale).pricing;

const page = pricingPage(locale, t);
---

<Base description={t.description} path="pricing" title={`${t.title} · Peal`}>
  <section class="mx-auto max-w-6xl px-6 pt-16 pb-8">
    <h1 class="text-4xl font-semibold tracking-tight">{t.title}</h1>
    <p class="mt-4 max-w-3xl text-lg text-neutral-600">{page.lead}</p>
    <ul class="mt-4 flex max-w-3xl flex-col gap-1 text-sm text-neutral-600">
      <li>{t.taxes.excluded}</li>
      {page.vat === null ? null : <li>{page.vat}</li>}
      <li>{t.taxes.vat}</li>
      <li>{t.taxes.currency}</li>
      <li>{t.taxes.reverseCharge}</li>
    </ul>
  </section>

  <section class="mx-auto grid max-w-6xl gap-8 px-6 pb-8 lg:grid-cols-2">
    <div class="rounded-2xl border border-neutral-200 p-5">
      <h2 class="text-lg font-semibold">{t.ladder.title}</h2>
      <p class="mt-2 text-sm text-neutral-600">{t.ladder.lead}</p>
      <table class="mt-4 w-full text-sm">
        <caption class="sr-only">{t.ladder.caption}</caption>
        <thead>
          <tr>
            <th class="pb-2 text-left font-medium" scope="col">
              {t.ladder.accounts}
            </th>
            <th class="pb-2 text-right font-medium" scope="col">
              {t.ladder.price}
            </th>
          </tr>
        </thead>
        <tbody>
          {
            page.ladder.map((row) => (
              <tr class="border-t border-neutral-200">
                <th class="py-2 pr-4 text-left font-medium" scope="row">
                  {row.accounts}
                </th>
                <td class="py-2 text-right tabular-nums">{row.text}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
      <p class="mt-4 text-sm text-neutral-600">{page.dayRule}</p>
    </div>

    <div class="rounded-2xl border border-neutral-200 p-5">
      <h2 class="text-lg font-semibold">{t.examples.title}</h2>
      <p class="mt-2 text-sm text-neutral-600">{t.examples.lead}</p>
      <table class="mt-4 w-full text-sm">
        <caption class="sr-only">{t.examples.caption}</caption>
        <thead>
          <tr>
            <th class="pb-2 text-left font-medium" scope="col">
              {t.examples.accounts}
            </th>
            <th class="pb-2 text-right font-medium" scope="col">
              {t.examples.month}
            </th>
          </tr>
        </thead>
        <tbody>
          {
            page.examples.map((row) => (
              <tr class="border-t border-neutral-200">
                <td class="py-2 pr-4 tabular-nums">{row.accounts}</td>
                <td class="py-2 text-right tabular-nums">{row.text}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
      <h3 class="mt-6 font-semibold">{t.partMonth.title}</h3>
      <p class="mt-2 text-sm text-neutral-600 tabular-nums">
        {page.partMonth.text}
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-6 py-8">
    <h2 class="text-2xl font-semibold tracking-tight">{t.meters.title}</h2>
    <p class="mt-2 max-w-3xl text-neutral-600">{t.meters.lead}</p>
    <ul class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        page.meters.map((row) => (
          <li class="flex flex-col gap-1 rounded-2xl border border-neutral-200 p-5">
            <h3 class="font-semibold">{row.name}</h3>
            <p class="text-sm tabular-nums">{row.allowance}</p>
            {row.priceText === null ? null : (
              <p class="text-sm tabular-nums">{row.priceText}</p>
            )}
            {row.note === null ? null : (
              <p class="text-sm text-neutral-600">{row.note}</p>
            )}
          </li>
        ))
      }
    </ul>
  </section>

  <section class="mx-auto grid max-w-6xl gap-8 px-6 py-8 lg:grid-cols-2">
    <div>
      <h2 class="text-lg font-semibold">{t.unlimited.title}</h2>
      <ul class="mt-2 flex list-disc flex-col gap-1 pl-5 text-neutral-600">
        {t.unlimited.items.map((item) => <li>{item}</li>)}
      </ul>
    </div>
    <div>
      <h2 class="text-lg font-semibold">{t.storage.title}</h2>
      <p class="mt-2 text-neutral-600">{page.storage}</p>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-6 pt-8 pb-24">
    <h2 class="text-2xl font-semibold tracking-tight">{t.legal.title}</h2>
    <ul
      class="mt-4 flex max-w-3xl list-disc flex-col gap-2 pl-5 text-neutral-600"
    >
      <li>{t.legal.billing}</li>
      <li>{t.legal.cancel}</li>
      <li>{t.legal.withdrawal}</li>
      <li>{t.legal.prices}</li>
      <li>{t.legal.legacy}</li>
      <li>{t.selfHost}</li>
    </ul>
    <p class="mt-4">
      <a
        href={getRelativeLocaleUrl(locale, "terms")}
        class="font-medium underline underline-offset-4"
      >
        {t.legal.terms}
      </a>
    </p>
  </section>
</Base>
