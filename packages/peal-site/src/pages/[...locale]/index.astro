---
import type { GetStaticPaths } from "astro";

import { Features } from "../../components/features.tsx";
import { docsLink } from "../../config.ts";
import { localePaths, pageLocale } from "../../i18n/locales.ts";
import { messages } from "../../i18n/messages.ts";
import Base from "../../layouts/base.astro";

export const getStaticPaths = (() => localePaths()) satisfies GetStaticPaths;

const locale = pageLocale(Astro.currentLocale);

const t = messages(locale).home;

const selfHostingGuide = docsLink(locale, "self-hosting");
---

<Base description={t.description} path="" title={t.title}>
  <section class="mx-auto max-w-5xl px-6 pt-20 pb-16 sm:pt-28">
    <p
      class="mb-6 inline-block rounded-full border border-neutral-300 px-3 py-1 text-sm text-neutral-600 dark:border-neutral-700 dark:text-neutral-400"
    >
      {t.hero.status}
    </p>
    <h1 class="max-w-3xl text-4xl font-semibold tracking-tight sm:text-6xl">
      {t.hero.title}
    </h1>
    <p class="mt-6 max-w-2xl text-lg text-neutral-600 dark:text-neutral-400">
      {t.hero.lead}
    </p>
    <div class="mt-10 flex flex-wrap gap-4">
      <a
        href="#features"
        class="rounded-full bg-neutral-900 px-5 py-2.5 text-sm font-medium text-white hover:bg-neutral-700 dark:bg-white dark:text-neutral-900 dark:hover:bg-neutral-200"
      >
        {t.hero.primary}
      </a>
      <a
        href="#self-host"
        class="rounded-full border border-neutral-300 px-5 py-2.5 text-sm font-medium hover:border-neutral-500 dark:border-neutral-700 dark:hover:border-neutral-400"
      >
        {t.hero.secondary}
      </a>
    </div>
  </section>

  <section
    id="features"
    aria-labelledby="features-title"
    class="mx-auto max-w-5xl scroll-mt-8 px-6 py-16"
  >
    <h2 id="features-title" class="text-2xl font-semibold tracking-tight">
      {t.featuresTitle}
    </h2>
    <div class="mt-8">
      <Features features={t.features} />
    </div>
    <div
      class="mt-4 rounded-2xl bg-neutral-100 p-6 dark:bg-neutral-900"
      role="note"
    >
      <h3 class="text-lg font-semibold">{t.unconfirmed.title}</h3>
      <p class="mt-2 text-neutral-600 dark:text-neutral-400">
        {t.unconfirmed.body}
      </p>
    </div>
  </section>

  <section
    class="mx-auto grid max-w-5xl gap-12 px-6 py-16 pb-24 sm:grid-cols-2"
  >
    <div id="self-host" class="scroll-mt-8">
      <h2 class="text-2xl font-semibold tracking-tight">{t.selfHost.title}</h2>
      <p class="mt-4 text-neutral-600 dark:text-neutral-400">
        {t.selfHost.body}
      </p>
      {
        selfHostingGuide !== undefined && (
          <p class="mt-4">
            <a
              href={selfHostingGuide}
              class="font-medium underline underline-offset-4"
            >
              {t.selfHost.docs}
            </a>
          </p>
        )
      }
    </div>
    <div>
      <h2 class="text-2xl font-semibold tracking-tight">
        {t.fairSource.title}
      </h2>
      <p class="mt-4 text-neutral-600 dark:text-neutral-400">
        {t.fairSource.body}
      </p>
    </div>
  </section>
</Base>
