---
import { getRelativeLocaleUrl } from "astro:i18n";

import { appLink, repositoryUrl, socialAccounts } from "../config.ts";
import type { Locale } from "../i18n/locales.ts";
import { messages } from "../i18n/messages.ts";
import { legalDocuments } from "../legal.ts";
import LanguageLinks from "./language-links.astro";

interface Props {
  readonly locale: Locale;
  readonly path: string;
}

const { locale, path } = Astro.props;

const t = messages(locale);

// The functions to cancel a contract and to withdraw from one, which the
// web app serves to anyone: on every page, under the law's own words.
const contract = [
  { href: appLink(locale, "cancel"), label: t.footer.cancel },
  { href: appLink(locale, "withdraw"), label: t.footer.withdraw },
].flatMap(({ href, label }) => (href === undefined ? [] : [{ href, label }]));
---

<footer class="border-t border-neutral-200">
  <div
    class="mx-auto flex max-w-5xl flex-col gap-6 px-6 py-10 text-sm text-neutral-600 sm:flex-row sm:items-start sm:justify-between"
  >
    <nav aria-label={t.footer.legal}>
      <ul class="flex flex-col gap-2">
        {
          legalDocuments.map((document) => (
            <li>
              <a
                href={getRelativeLocaleUrl(locale, document)}
                class="hover:text-neutral-900 hover:underline"
              >
                {t.legal[document]}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    {
      contract.length === 0 ? null : (
        <nav aria-label={t.footer.contract}>
          <ul class="flex flex-col gap-2">
            {contract.map(({ href, label }) => (
              <li>
                <a
                  href={href}
                  class="hover:text-neutral-900 hover:underline"
                >
                  {label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      )
    }
    <nav aria-label={t.footer.follow}>
      <ul class="flex flex-col gap-2">
        {
          socialAccounts.map(({ href, name, rel }) => (
            <li>
              <a href={href} rel={rel} class="hover:text-neutral-900 hover:underline">
                {name}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <div class="flex flex-col gap-4 sm:items-end">
      <LanguageLinks label={t.footer.language} locale={locale} path={path} />
      <p class="max-w-sm sm:text-right">{t.footer.license}</p>
      <a
        href={repositoryUrl}
        class="hover:text-neutral-900 hover:underline"
      >
        {t.footer.source}
      </a>
    </div>
  </div>
</footer>
