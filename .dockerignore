# Build context for the images in packages/peal-docker, which build from the
# repository root. Installs happen inside the image, so local dependencies,
# caches and state stay out, and so do secrets.

# Version control and CI
.git
.github

# Dependencies, builds and caches
**/node_modules
**/dist
**/build
**/.next
**/.astro
**/.blume
**/.blume-verify
**/out
**/coverage
**/*.tsbuildinfo
.nx
.cache
**/.venv
**/.ansible
.e2e
.local
.claude

# Secrets and local data
**/.env*
**/*.pem
**/*.key
**/*.p12

# Agent guides, which sit beside the sources the images copy
**/AGENTS.md
**/CLAUDE.md

# Editors and logs
.idea
.vscode
**/.DS_Store
**/*.log
