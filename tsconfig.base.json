{
  "$schema": "./node_modules/@effect/tsgo/schema.json",
  "compilerOptions": {
    "target": "ES2024",
    "lib": ["esnext"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "skipLibCheck": true,
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noPropertyAccessFromIndexSignature": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "types": [],
    // Effect's language service: diagnostics in the editor and in tsc,
    // which `effect-tsgo patch` (the root package's prepare) makes Effect's.
    // Errors and warnings fail typecheck; suggestions show in the editor.
    "plugins": [
      {
        "name": "@effect/language-service",
        "includeSuggestionsInTsc": false,
        // Effect 4 ships these modules as unstable, and Peal is built on them:
        // each module the code uses, by name, so one it starts to use warns
        // until it is added here.
        "allowedUnstableApis": [
          "@effect/ai-anthropic/AnthropicClient",
          "@effect/ai-anthropic/AnthropicLanguageModel",
          "@effect/ai-openai-compat/OpenAiClient",
          "@effect/ai-openai-compat/OpenAiLanguageModel",
          "@effect/atom-react/Hooks",
          "@effect/atom-react/ReactHydration",
          "@effect/atom-react/RegistryContext",
          "@effect/platform-bun/BunFileSystem",
          "@effect/platform-bun/BunHttpServer",
          "@effect/platform-bun/BunPath",
          "@effect/platform-bun/BunRuntime",
          "@effect/platform-bun/BunServices",
          "@effect/platform-node-shared/NodeChildProcessSpawner",
          "@effect/platform-node-shared/NodeFileSystem",
          "@effect/sql-pg/PgClient",
          "@effect/vitest",
          "effect/ai/AiError",
          "effect/ai/LanguageModel",
          "effect/ai/McpProtocol",
          "effect/ai/McpSchema",
          "effect/ai/McpServer",
          "effect/ai/Prompt",
          "effect/ai/Response",
          "effect/ai/Tool",
          "effect/ai/Toolkit",
          "effect/ByteSize",
          "effect/cli/Argument",
          "effect/cli/CliError",
          "effect/cli/CliOutput",
          "effect/cli/Command",
          "effect/cli/Flag",
          "effect/cli/HelpDoc",
          "effect/cli/Prompt",
          "effect/cluster/ClusterCron",
          "effect/cluster/ClusterError",
          "effect/cluster/ClusterSchema",
          "effect/cluster/ClusterWorkflowEngine",
          "effect/cluster/Entity",
          "effect/cluster/MachineId",
          "effect/cluster/MessageStorage",
          "effect/cluster/RunnerAddress",
          "effect/cluster/RunnerHealth",
          "effect/cluster/Runners",
          "effect/cluster/RunnerStorage",
          "effect/cluster/Sharding",
          "effect/cluster/ShardingConfig",
          "effect/cluster/SingleRunner",
          "effect/cluster/Snowflake",
          "effect/crypto/Aead",
          "effect/crypto/Digest",
          "effect/crypto/Mac",
          "effect/crypto/SecureRandom",
          "effect/FileSystem",
          "effect/http-api/HttpApi",
          "effect/http-api/HttpApiBuilder",
          "effect/http-api/HttpApiClient",
          "effect/http-api/HttpApiEndpoint",
          "effect/http-api/HttpApiError",
          "effect/http-api/HttpApiGroup",
          "effect/http-api/HttpApiMiddleware",
          "effect/http-api/HttpApiSchema",
          "effect/http-api/HttpApiSecurity",
          "effect/http-api/HttpApiTest",
          "effect/http-api/OpenApi",
          "effect/http/Cookies",
          "effect/http/FetchHttpClient",
          "effect/http/Headers",
          "effect/http/HttpClient",
          "effect/http/HttpClientError",
          "effect/http/HttpClientRequest",
          "effect/http/HttpClientResponse",
          "effect/http/HttpEffect",
          "effect/http/HttpIncomingMessage",
          "effect/http/HttpMiddleware",
          "effect/http/HttpRouter",
          "effect/http/HttpServer",
          "effect/http/HttpServerError",
          "effect/http/HttpServerRequest",
          "effect/http/HttpServerResponse",
          "effect/http/UrlParams",
          "effect/net/IpNetwork",
          "effect/net/NetAddress",
          "effect/observability/Otlp",
          "effect/observability/OtlpSerialization",
          "effect/Path",
          "effect/persistence/RateLimiter",
          "effect/PlatformError",
          "effect/process/ChildProcess",
          "effect/process/ChildProcessSpawner",
          "effect/reactivity/AsyncResult",
          "effect/reactivity/Atom",
          "effect/reactivity/AtomHttpApi",
          "effect/reactivity/AtomRegistry",
          "effect/reactivity/Hydration",
          "effect/reactivity/Reactivity",
          "effect/rpc/Rpc",
          "effect/sql/SqlClient",
          "effect/sql/SqlError",
          "effect/sql/Statement",
          "effect/Stdio",
          "effect/Terminal",
          "effect/testing/TestConsole",
          "effect/workflow/Activity",
          "effect/workflow/DurableClock",
          "effect/workflow/Workflow",
          "effect/workflow/WorkflowEngine"
        ],
        // The outbound guard resolves names itself (Dns), and the MCP tests
        // call the server as a client would.
        "allowedExperimentalApis": [
          "@effect/platform-bun/BunDns",
          "effect/ai/McpClient",
          "effect/net/Dns"
        ]
      }
    ]
  }
}
