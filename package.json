{
  "name": "peal",
  "private": true,
  "homepage": "https://peal.social",
  "bugs": "https://github.com/peal-social/peal/issues",
  "license": "FSL-1.1-ALv2",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/peal-social/peal.git"
  },
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "references": "bun scripts/references.ts",
    "check": "nx run-many -t typegen && ultracite check",
    "fix": "ultracite fix",
    "typecheck": "tsc --noEmit -p . && nx run-many -t typecheck",
    "test": "nx run-many -t test",
    "build": "nx run-many -t build",
    "sdk:generate": "nx run-many -t sdk:generate",
    "sdk:build": "nx run-many -t sdk:build",
    "sdk:check": "nx run peal-sdk:check",
    "sdk:test": "nx run-many -t sdk:test",
    "nx": "nx"
  },
  "devDependencies": {
    "@types/bun": "1.4.4",
    "@types/node": "26.6.6",
    "effect": "4.1.2",
    "fern-api": "5.201.0",
    "nx": "24.0.5",
    "oxfmt": "0.77.0",
    "oxlint": "1.92.0",
    "oxlint-tsgolint": "7.0.2006",
    "typescript": "7.0.2",
    "ultracite": "8.1.1"
  },
  "engines": {
    "bun": "1.4.4",
    "node": ">=26.13.0"
  },
  "packageManager": "bun@1.4.4"
}
