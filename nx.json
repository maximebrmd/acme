{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "workspaceLayout": {
    "appsDir": "packages",
    "libsDir": "packages"
  },
  "neverConnectToCloud": true,
  "namedInputs": {
    "default": [
      "{projectRoot}/**/*",
      "!{projectRoot}/**/AGENTS.md",
      "!{projectRoot}/**/CLAUDE.md",
      "workspaceConfig"
    ],
    "workspaceConfig": [
      "{workspaceRoot}/nx.json",
      "{workspaceRoot}/package.json",
      "{workspaceRoot}/bun.lock",
      "{workspaceRoot}/tsconfig.base.json"
    ]
  },
  "targetDefaults": {
    "typecheck": {
      "cache": true,
      "inputs": ["default", "^default"]
    },
    "build": {
      "dependsOn": ["^build", "typecheck"],
      "cache": true,
      "inputs": ["default", "^default"]
    },
    "test": {
      "cache": false
    },
    "e2e": {
      "cache": false
    },
    "typegen": {
      "cache": false
    },
    "sdk:generate": {
      "dependsOn": [
        {
          "projects": ["tag:sdk-spec"],
          "target": "spec"
        }
      ],
      "cache": false
    },
    "sdk:build": {
      "cache": true,
      "inputs": ["default", "{workspaceRoot}/packages/peal-sdk/scripts/**/*"]
    },
    "sdk:test": {
      "dependsOn": ["sdk:build"],
      "cache": false
    }
  },
  "analytics": true
}
